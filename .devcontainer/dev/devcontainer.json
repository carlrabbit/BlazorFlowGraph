{
  "name": "BlazorFlowGraph",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "lts",
      "installUsingApt": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "nodeGypDependencies": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.vscode-dotnet-runtime",
        "biomejs.biome",
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "[csharp]": {
          "editor.defaultFormatter": "ms-dotnettools.csharp"
        },
        "typescript.preferences.importModuleSpecifier": "relative"
      }
    }
  },
  "onCreateCommand": "curl -fsSL https://bun.sh/install | bash && echo 'export PATH=\"$HOME/.bun/bin:$PATH\"' >> ~/.bashrc",
  "updateContentCommand": "$HOME/.bun/bin/bun install && dotnet restore BlazorFlowGraph.slnx",
  "forwardPorts": [5000, 5001, 5100, 5101, 5102, 5103, 5104, 5105],
  "portsAttributes": {
    "5000": {
      "label": "Blazor HTTP",
      "onAutoForward": "notify"
    },
    "5001": {
      "label": "Blazor HTTPS",
      "onAutoForward": "notify"
    },
    "5100": {
      "label": "BlazorFlowGraph Sample Index",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    },
    "5101": {
      "label": "Minimal Viewer",
      "visibility": "public"
    },
    "5102": {
      "label": "Incremental Updates",
      "visibility": "public"
    },
    "5103": {
      "label": "Layout Playground",
      "visibility": "public"
    },
    "5104": {
      "label": "Large Graph Stress",
      "visibility": "public"
    },
    "5105": {
      "label": "Semantic Annotations",
      "visibility": "public"
    }
  },
  "remoteUser": "vscode"
}
