@page "/"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@using BlazorFlowGraph.Blazor
@using BlazorFlowGraph.Protocol

<h1>Incremental Updates</h1>

<div class="controls">
    <button @onclick="AddNode">Add Node</button>
    <button @onclick="RemoveLastNode" disabled="@(_snapshot.Nodes.Count == 0)">Remove Node</button>
    <button @onclick="Reset">Reset</button>
    <span class="hint">
        Version @_snapshot.Version &bull; @_snapshot.Nodes.Count nodes &bull; @_snapshot.Edges.Count edges
    </span>
</div>

<DataflowGraph Snapshot="@_snapshot" Width="900" Height="480" />

@code {
    private static readonly string[] NodeKinds = ["service", "datastore", "queue", "gateway"];

    private int _nextId = 4;
    private GraphSnapshot _snapshot = CreateInitialSnapshot(0);

    private void AddNode()
    {
        var id = new NodeId($"node-{_nextId}");
        var label = $"Node {_nextId}";
        var kind = NodeKinds[(_nextId - 1) % NodeKinds.Length];
        _nextId++;

        var newNodes = _snapshot.Nodes
            .Append(new GraphNode(id, label, kind))
            .ToList();

        var newEdges = _snapshot.Edges.ToList();
        if (_snapshot.Nodes.Count > 0)
        {
            var sourceNode = _snapshot.Nodes[^1];
            newEdges.Add(new GraphEdge(
                new EdgeId($"e-{sourceNode.Id.Value}-{id.Value}"),
                sourceNode.Id,
                id));
        }

        var nextSnapshot = new GraphSnapshot(_snapshot.Version + 1, newNodes, newEdges);
        _snapshot = nextSnapshot;
    }

    private void RemoveLastNode()
    {
        if (_snapshot.Nodes.Count == 0) return;

        var removedId = _snapshot.Nodes[^1].Id;
        var newNodes = _snapshot.Nodes.SkipLast(1).ToList();
        var newEdges = _snapshot.Edges
            .Where(e => e.SourceId != removedId && e.TargetId != removedId)
            .ToList();

        _snapshot = new GraphSnapshot(_snapshot.Version + 1, newNodes, newEdges);
    }

    private void Reset()
    {
        _nextId = 4;
        _snapshot = CreateInitialSnapshot(_snapshot.Version + 1);
    }

    private static GraphSnapshot CreateInitialSnapshot(int version)
    {
        var gateway = new GraphNode(new NodeId("node-1"), "API Gateway", "gateway");
        var service = new GraphNode(new NodeId("node-2"), "Orders Service", "service");
        var datastore = new GraphNode(new NodeId("node-3"), "Orders DB", "datastore");

        return new GraphSnapshot(
            version,
            [gateway, service, datastore],
            [
                new GraphEdge(new EdgeId("e-node-1-node-2"), gateway.Id, service.Id, "routes"),
                new GraphEdge(new EdgeId("e-node-2-node-3"), service.Id, datastore.Id, "writes"),
            ]);
    }
}
