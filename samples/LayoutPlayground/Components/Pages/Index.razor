@page "/"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@using BlazorFlowGraph.Blazor
@using BlazorFlowGraph.Protocol

<h1>Layout Playground</h1>

<div class="controls">
    <label>
        Nodes:&nbsp;
        <input type="number" min="1" max="50" @bind="_nodeCount" @bind:event="oninput" />
    </label>
    <label style="margin-left:1rem">
        <input type="checkbox" @bind="_useGroups" />
        &nbsp;Groups
    </label>
    <button @onclick="Regenerate" style="margin-left:1rem">Regenerate</button>
    <span class="hint" style="margin-left:1rem">Pan: drag &bull; Zoom: scroll &bull; Graph version: @_snapshot?.Version &bull; Nodes: @(_snapshot?.Nodes.Count ?? 0)</span>
</div>

<DataflowGraph Snapshot="@_snapshot" Width="960" Height="540" />

@if (_snapshot?.Groups?.Count > 0)
{
    <div class="hint" style="margin-top:0.5rem">
        Groups: @string.Join(", ", _snapshot.Groups.Select(g => $"{g.Label} ({g.ChildNodeIds.Count} nodes)"))
    </div>
}

@code {
    private int _nodeCount = 8;
    private bool _useGroups;
    private int _version;
    private GraphSnapshot? _snapshot;

    protected override void OnInitialized() => Regenerate();

    private void Regenerate()
    {
        var count = Math.Clamp(_nodeCount, 1, 50);

        // Node kinds correspond to entries in the TypeScript defaultStyleTokens registry.
        // Each kind maps to a distinct visual style (fill, stroke, corner radius).
        string[] kinds = ["default", "service", "datastore", "gateway", "queue"];

        var nodes = Enumerable.Range(1, count)
            .Select(i => new GraphNode(
                new NodeId($"n{i}"),
                $"Node {i}",
                kinds[(i - 1) % kinds.Length]))
            .ToList();

        // Seed with _version for reproducibility within a session;
        // each click produces a different but stable topology.
        var rng = new Random(_version);
        var edges = new List<GraphEdge>();
        for (int i = 1; i < nodes.Count; i++)
        {
            var src = nodes[rng.Next(i)];
            var dst = nodes[i];
            edges.Add(new GraphEdge(
                new EdgeId($"e{i}"),
                src.Id,
                dst.Id));
        }

        // Optional groups: split nodes into two groups
        var groups = new List<GraphGroup>();
        if (_useGroups && count >= 2)
        {
            var mid = count / 2;
            groups.Add(new GraphGroup(
                new GroupId("g1"),
                "Group A",
                "group",
                nodes.Take(mid).Select(n => n.Id).ToList()));
            groups.Add(new GraphGroup(
                new GroupId("g2"),
                "Group B",
                "group",
                nodes.Skip(mid).Select(n => n.Id).ToList()));
        }

        _snapshot = new GraphSnapshot(++_version, nodes, edges, groups.Count > 0 ? groups : null);
    }
}
