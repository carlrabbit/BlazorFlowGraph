@using Microsoft.AspNetCore.Components.Web
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Large Graph Stress — Dataflow Graph</title>
    <base href="/" />
    <HeadOutlet />
    <style>
        body { margin: 0; font-family: sans-serif; background: #f9fafb; }
        h1 { padding: 1rem; color: #1f2937; font-size: 1.25rem; }
        .controls { padding: 0 1rem 1rem; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
        label { font-size: 0.875rem; color: #374151; }
        input[type=number] { width: 80px; padding: 0.25rem; border: 1px solid #d1d5db; border-radius: 4px; }
        button { padding: 0.4rem 0.9rem; border-radius: 4px; border: 1px solid #6366f1;
                 background: #6366f1; color: #fff; cursor: pointer; font-size: 0.875rem; }
        button:hover { background: #4f46e5; }
        .hint { color: #6b7280; font-size: 0.75rem; }
    </style>
</head>
<body>
    <Routes />
    <script src="_framework/blazor.server.js"></script>
    <script src="_content/BlazorFlowGraph.Blazor/js/dataflow-visualizer.js"></script>
</body>
</html>
